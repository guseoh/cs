filters:
  and:
  - file.inFolder("Workspace/Items")
  - file.ext == "md"
properties:
  note.progress:
    displayName: 진행 상태
  note.track:
    displayName: 분류
  note.review_on:
    displayName: 복습일
  note.target_on:
    displayName: 마일스톤
views:
- type: cards
  name: 예정
  filters:
    and:
    - progress == "예정"
  order:
  - file.name
  - track
  - review_on
  - target_on
- type: cards
  name: 진행 중
  filters:
    and:
    - progress == "진행 중"
  order:
  - file.name
  - track
  - review_on
  - target_on
- type: cards
  name: 보류
  filters:
    and:
    - progress == "보류"
  order:
  - file.name
  - track
  - review_on
  - target_on
- type: cards
  name: 완료
  filters:
    and:
    - progress == "완료"
  order:
  - file.name
  - track
  - review_on
  - target_on
- type: table
  name: 전체 카드
  order:
  - file.name
  - progress
  - track
  - review_on
  - target_on
