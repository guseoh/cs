filters:
  and:
    - file.ext == "md"
    - file.inFolder("Study") || file.inFolder("Wiki") || file.inFolder("Project")
views:
  - type: table
    name: 최근 수정
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 8
  - type: table
    name: 최근 학습
    filters:
      and:
        - file.inFolder("Study")
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 12
  - type: table
    name: 최근 Wiki 결정
    filters:
      and:
        - file.inFolder("Wiki/decisions")
    order:
      - file.name
      - updated_at
    sort:
      - property: updated_at
        direction: DESC
    limit: 12
  - type: table
    name: 최근 프로젝트
    filters:
      and:
        - file.inFolder("Project")
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 12
