filters:
  and:
    - file.inFolder("References/Tech Articles/Articles")
    - 'type == "tech-article"'
formulas:
  article: 'file.asLink(title)'
  month: 'collected.format("YYYY-MM")'
properties:
  formula.article:
    displayName: 기술 글
  note.summary:
    displayName: 핵심 요약
  note.source:
    displayName: 출처
  note.collected:
    displayName: 수집일
  note.published:
    displayName: 발행일
  note.topic:
    displayName: 대표 주제
  note.tags:
    displayName: 세부 태그
  note.status:
    displayName: 읽기 상태
views:
  - type: table
    name: 최근 수집
    limit: 12
    order:
      - formula.article
      - note.summary
      - note.collected
      - note.topic
      - note.status
    sort:
      - property: note.collected
        direction: DESC
  - type: table
    name: 날짜별
    groupBy:
      property: note.collected
      direction: DESC
    order:
      - formula.article
      - note.summary
      - note.source
      - note.topic
      - note.status
    sort:
      - property: note.collected
        direction: DESC
  - type: table
    name: 월별
    groupBy:
      property: formula.month
      direction: DESC
    order:
      - formula.article
      - note.collected
      - note.topic
      - note.source
    sort:
      - property: note.collected
        direction: DESC
  - type: table
    name: 태그별
    groupBy:
      property: note.topic
      direction: ASC
    order:
      - formula.article
      - note.summary
      - note.collected
      - note.tags
    sort:
      - property: note.collected
        direction: DESC
  - type: table
    name: 읽기 대기
    filters:
      and:
        - 'status == "inbox"'
    order:
      - formula.article
      - note.topic
      - note.collected
    sort:
      - property: note.collected
        direction: DESC
  - type: table
    name: 학습 완료
    filters:
      and:
        - 'status == "reviewed"'
    order:
      - formula.article
      - note.topic
      - note.collected
    sort:
      - property: note.collected
        direction: DESC
  - type: table
    name: 전체 자료
    order:
      - formula.article
      - note.summary
      - note.collected
      - note.published
      - note.topic
      - note.tags
      - note.status
    sort:
      - property: note.collected
        direction: DESC
