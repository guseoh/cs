filters:
  and:
    - file.inFolder("References/Tech Articles/Articles")
    - type == "tech-article"
formulas:
  article: file.asLink(title)
  month: collected.format("YYYY-MM")
properties:
  formula.article:
    displayName: 기술 글
  note.summary:
    displayName: 핵심 요약
  note.source:
    displayName: 출처
  note.collected:
    displayName: 수집일
  note.published:
    displayName: 발행일
  note.topic:
    displayName: 대표 주제
  note.tags:
    displayName: 세부 태그
  note.status:
    displayName: 읽기 상태
views:
  - type: table
    name: 최근 수집
    order:
      - formula.article
      - summary
      - collected
      - topic
      - status
    sort:
      - property: collected
        direction: DESC
    limit: 12
  - type: table
    name: 날짜별
    groupBy:
      property: collected
      direction: DESC
    order:
      - formula.article
      - summary
      - source
      - topic
      - status
    sort:
      - property: collected
        direction: DESC
  - type: table
    name: 월별
    groupBy:
      property: formula.month
      direction: DESC
    order:
      - formula.article
      - collected
      - topic
      - source
    sort:
      - property: collected
        direction: DESC
  - type: table
    name: 태그별
    groupBy:
      property: topic
      direction: ASC
    order:
      - formula.article
      - summary
      - collected
      - tags
    sort:
      - property: collected
        direction: DESC
  - type: table
    name: 읽기 대기
    filters:
      and:
        - status == "inbox"
    order:
      - formula.article
      - topic
      - collected
    sort:
      - property: collected
        direction: DESC
  - type: table
    name: 학습 완료
    filters:
      and:
        - status == "reviewed"
    order:
      - formula.article
      - topic
      - collected
    sort:
      - property: collected
        direction: DESC
  - type: table
    name: 전체 자료
    order:
      - formula.article
      - summary
      - collected
      - published
      - topic
      - tags
      - status
    sort:
      - property: collected
        direction: DESC
